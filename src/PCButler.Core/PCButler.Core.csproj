<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PCButler.Core</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reads the graphics card's use from Windows' own counters (the number Task Manager shows). -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.8" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.0" />
    <!-- Reads temperature and fan sensors through WMI (only used by the optional administrator helper). -->
    <PackageReference Include="System.Management" Version="10.0.2" />
    <!-- Portal: Windows' own protection for the key of this PC's certificate. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <!-- Portal: the server other PCs connect to. Part of .NET, no extra download for users. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Translations\ar.json" LogicalName="PCButler.Core.ar.json" />
    <!-- The list of changes shown in the What's new window. -->
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="PCButler.Core.CHANGELOG.md" />
    <EmbeddedResource Include="..\..\CHANGELOG.ar.md" LogicalName="PCButler.Core.CHANGELOG.ar.md" WithCulture="false" />
  </ItemGroup>

</Project>
