<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PCButler.Core</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The base library: settings, translations, the log, history, and how PC Butler's processes talk.
         The features are in PCButler.Core.Files, .Search, .Sensors, .System and .Portal. -->
    <InternalsVisibleTo Include="PCButler.Core.Files" />
    <InternalsVisibleTo Include="PCButler.Core.Search" />
    <InternalsVisibleTo Include="PCButler.Core.Sensors" />
    <InternalsVisibleTo Include="PCButler.Core.System" />
    <InternalsVisibleTo Include="PCButler.Core.Portal" />
    <InternalsVisibleTo Include="PCButler" />
    <InternalsVisibleTo Include="PCButler.Agent" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Translations\ar.json" LogicalName="PCButler.Core.ar.json" />
    <!-- The list of changes shown in the What's new window. -->
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="PCButler.Core.CHANGELOG.md" />
    <EmbeddedResource Include="..\..\CHANGELOG.ar.md" LogicalName="PCButler.Core.CHANGELOG.ar.md" WithCulture="false" />
  </ItemGroup>

</Project>
