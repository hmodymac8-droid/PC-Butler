<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Windows Forms is used only for the tray icon. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PCButler</AssemblyName>
    <RootNamespace>PCButler</RootNamespace>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.23.1</Version>
    <Product>PC Butler</Product>
    <Company>hmodymac8-droid</Company>
    <Copyright>Copyright (c) 2026 hmodymac8-droid. All rights reserved.</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Memory: PC Butler is several small processes now (agent, board, one per tool), so each
         uses the workstation collector without a background GC thread, and gives memory back
         to Windows sooner (ConserveMemory below). Tiered PGO keeps the hot paths quick. -->
    <TieredPGO>true</TieredPGO>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollector>false</ServerGarbageCollector>
  </PropertyGroup>

  <ItemGroup>
    <!-- 0-9: how hard the collector works to keep the heap small; 5 trades a little speed for a lot less memory. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both UI frameworks define Application, Button, MessageBox...; WPF's are the ones meant here. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PCButler.Core\PCButler.Core.csproj" />
    <!-- The QR code of the phone app's download link (MIT licence). -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <Resource Include="icon.png" />
    <Resource Include="icon.ico" />
    <Resource Include="logo.ico" />
    <!-- Also beside PCButler.exe: File Explorer's right-click menu shows it. -->
    <None Include="logo.ico" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Fonts\*.ttf" />
  </ItemGroup>

</Project>
