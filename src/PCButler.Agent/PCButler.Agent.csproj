<Project Sdk="Microsoft.NET.Sdk">

  <!-- The background agent: the tray icon and the background features, with no WPF and no
       Windows Forms, so it stays small. Windows it would show are shown by the companion
       (PCButler.exe with the ui switch). Published into the same folder as PCButler.exe, sharing its runtime. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PCButler.Agent</AssemblyName>
    <RootNamespace>PCButler.Agent</RootNamespace>
    <ApplicationIcon>..\PCButler\logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.1.0</Version>
    <Product>PC Butler</Product>
    <Company>hmodymac8-droid</Company>
    <Copyright>Copyright (c) 2026 hmodymac8-droid. All rights reserved.</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TieredPGO>true</TieredPGO>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only what the background needs: no file search, and Courier stays in the companion
         (PCButler.Core.System still knows Courier, for the firewall rule its helper sets). -->
    <ProjectReference Include="..\PCButler.Core\PCButler.Core.csproj" />
    <ProjectReference Include="..\PCButler.Core.Files\PCButler.Core.Files.csproj" />
    <ProjectReference Include="..\PCButler.Core.Sensors\PCButler.Core.Sensors.csproj" />
    <ProjectReference Include="..\PCButler.Core.System\PCButler.Core.System.csproj" />
  </ItemGroup>

</Project>
